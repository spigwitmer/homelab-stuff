# configure then shove this data into the "Values" field under
# Parameters in the ArgoCD Application
homelabDeploy:
  # get this from http://pi.hole/ somewhere i can't remember exactly
  # where sorry, also enable sudo for app tokens
  piholeAppPassword: "mypassword"

  # get these from hopefully your password manager of choice
  nextcloud:
    db-username: 'nextcloud'
    nextcloud-username: 'idk'
    nextcloud-password: 'hunter2'
    postgresAdminPassword: 'hunter2'
    postgresUserPassword: 'hunter2'
    postgresReplicationPassword: 'hunter2'
    redis-password: 'hunter2'

  # get these from https://my.contabo.com/api/details
  contabo:
    clientId: 'idk'
    clientSecret: 'idk'
    username: 'pat'
    password: 'hunter2'

  # Local security stack secrets:
  # Frigate, Home Assistant, Mosquitto (mqtt)
  security:
    mqtt:
      # Single local MQTT user shared between Frigate publisher and HA subscriber
      username: 'frigate'
      password: 'hunter2'
    frigate:
      # Used for HTTP basic auth on the Frigate UI/API
      adminPassword: 'hunter2'
